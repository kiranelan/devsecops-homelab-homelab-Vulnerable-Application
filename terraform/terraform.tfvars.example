aws_region   = "us-west-2"
cluster_name = "eks-interview-lab"

# Replace this with a Kubernetes version currently in EKS standard support.
cluster_version = "1.35"

# Minimal practical capacity for this EKS/PostgreSQL demonstration. t3.medium if pods are in pending state
node_instance_type    = "t3.small"
node_desired_capacity = 1
node_max_capacity     = 1
use_spot_instances    = true

# Lowest-cost lab mode: no NAT Gateway. The managed worker node is placed
# in public subnets and receives a public IPv4 address for outbound access.
# Set to true only when private worker nodes and a single NAT Gateway are required.
enable_nat_gateway = false

# Keep WAF disabled until the ALB/WAF portion of the demonstration. Enabling now
enable_edge_security = true

waf_log_retention_days = 1
ecr_max_image_count    = 3
